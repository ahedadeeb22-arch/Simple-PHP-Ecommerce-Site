<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سلة المشتريات - متجر ميرا</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }
        .navbar {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%) !important;
            padding: 14px 0;
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: #fff !important;
        }
        .nav-link {
            color: #e2e8f0 !important;
            font-weight: 600;
            padding: 8px 14px !important;
        }
        .cart-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid #e2e8f0;
            padding: 30px;
        }
        .table {
            vertical-align: middle;
            margin-bottom: 0;
        }
        .table thead th {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 700;
            padding: 14px;
            border-bottom: 2px solid #e2e8f0;
        }
        .table tbody td {
            padding: 16px 14px;
            border-bottom: 1px solid #f1f5f9;
        }
        .cart-image {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }
        .btn-danger {
            background-color: #ef4444;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            font-weight: 600;
        }
        .btn-danger:hover {
            background-color: #dc2626;
        }
        .summary-card {
            background: #f8fafc;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            padding: 24px;
        }
        .btn-checkout {
            background-color: #10b981;
            border: none;
            color: #fff;
            border-radius: 12px;
            padding: 14px 24px;
            font-size: 1.1rem;
            font-weight: 700;
            transition: all 0.2s ease;
        }
        .btn-checkout:hover {
            background-color: #059669;
            color: #fff;
            transform: translateY(-2px);
        }
        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 30px 0;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/products.php">
                <i class="fas fa-bag-shopping text-primary me-2 ms-2 fs-3"></i> متجر ميرا
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/products.php"><i class="fas fa-arrow-right me-1 ms-1"></i> متابعة التسوق</a>
                    </li>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" href="/admin/index.php"><i class="fas fa-cogs me-1"></i> لوحة الإدارة</a>
                    </li>
                    <% } %>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/logout.php"><i class="fas fa-sign-out-alt me-1"></i> خروج</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="fas fa-shopping-cart text-primary me-2"></i> سلة مشترياتك</h2>
                <p class="text-muted mb-0">راجع المنتجات التي اخترتها قبل إتمام عملية الدفع والطلب</p>
            </div>
            <a href="/products.php" class="btn btn-outline-secondary">
                <i class="fas fa-plus me-1"></i> إضافة منتجات أخرى
            </a>
        </div>

        <% if (!cart_items || cart_items.length === 0) { %>
            <div class="cart-card text-center py-5">
                <div class="text-muted mb-3">
                    <i class="fas fa-cart-arrow-down fs-1" style="font-size: 4rem !important; opacity: 0.3;"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">سلة مشترياتك فارغة حالياً</h3>
                <p class="text-muted mb-4">لم تقم بإضافة أي منتجات إلى السلة بعد. تصفح أحدث العروض والمنتجات المميزة الآن!</p>
                <a href="/products.php" class="btn btn-primary px-4 py-2 fw-bold">
                    <i class="fas fa-shopping-bag me-1"></i> ابدأ التسوق الآن
                </a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-card p-0 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th style="width: 90px;">الصورة</th>
                                        <th>المنتج</th>
                                        <th>السعر</th>
                                        <th>الكمية</th>
                                        <th>الإجمالي</th>
                                        <th style="width: 100px;">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% cart_items.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <img src="<%= resolveImage(item.image) %>" class="cart-image" alt="<%= item.title %>">
                                            </td>
                                            <td>
                                                <h6 class="mb-0 fw-bold text-dark"><%= item.title %></h6>
                                                <small class="text-muted">سعر الحبة: <%= item.offer %> ر.س</small>
                                            </td>
                                            <td class="fw-bold text-primary"><%= item.offer %> ر.س</td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                                    <%= item.quantity %>
                                                </span>
                                            </td>
                                            <td class="fw-bold text-success fs-6"><%= item.offer * item.quantity %> ر.س</td>
                                            <td>
                                                <a href="/view_cart.php?action=remove&cart_id=<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('هل تريد حذف هذا المنتج من السلة؟')">
                                                    <i class="fas fa-trash-alt me-1"></i> حذف
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-card">
                        <h4 class="fw-bold text-dark mb-4 pb-2 border-bottom">ملخص الطلب</h4>
                        
                        <div class="summary-card mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">مجموع المنتجات:</span>
                                <span class="fw-bold"><%= total %> ر.س</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">تكلفة الشحن والتوصيل:</span>
                                <span class="text-success fw-bold">مجاناً</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">ضريبة القيمة المضافة:</span>
                                <span class="text-muted">مشمولة</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between fs-5 fw-bold">
                                <span>المبلغ الإجمالي:</span>
                                <span class="text-primary"><%= total %> ر.س</span>
                            </div>
                        </div>

                        <button type="button" class="btn btn-checkout w-100" onclick="alert('شكراً لك! تم استلام طلبك التجريبي بنجاح وسيتم تجهيزه فوراً.')">
                            <i class="fas fa-lock me-2"></i> إتمام الطلب والدفع الآمن
                        </button>

                        <div class="text-center mt-3 text-muted small">
                            <i class="fas fa-shield-alt text-success me-1"></i> ضمان استرجاع 14 يوم ودفع آمن 100%
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <footer class="text-center">
        <div class="container">
            <h5 class="fw-bold text-white mb-2">متجر ميرا الإلكتروني - Mera-Shop</h5>
            <p class="mb-0">جميع الحقوق محفوظة &copy; 2026</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
