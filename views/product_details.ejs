<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - متجر ميرا</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }
        .navbar {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%) !important;
            padding: 14px 0;
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: #fff !important;
        }
        .nav-link {
            color: #e2e8f0 !important;
            font-weight: 600;
            padding: 8px 14px !important;
        }
        .product-main-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            padding: 30px;
        }
        .product-image {
            width: 100%;
            max-height: 440px;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        }
        .price-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 14px;
            padding: 20px;
            margin: 20px 0;
        }
        .btn-success {
            background-color: #10b981;
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.2s ease;
        }
        .btn-success:hover {
            background-color: #059669;
            transform: translateY(-2px);
        }
        .related-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            transition: all 0.2s ease;
            background: #fff;
            overflow: hidden;
        }
        .related-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }
        .related-image {
            height: 160px;
            width: 100%;
            object-fit: cover;
        }
        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 30px 0;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/products.php">
                <i class="fas fa-bag-shopping text-primary me-2 ms-2 fs-3"></i> متجر ميرا
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/products.php"><i class="fas fa-arrow-right me-1 ms-1"></i> العودة للمنتجات</a>
                    </li>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" href="/admin/index.php"><i class="fas fa-cogs me-1"></i> لوحة الإدارة</a>
                    </li>
                    <% } %>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-2">
                        <a class="nav-link position-relative" href="/view_cart.php">
                            <i class="fas fa-shopping-cart me-1"></i> سلة المشتريات
                            <% if (typeof userCartCount !== 'undefined' && userCartCount > 0) { %>
                                <span class="badge bg-danger rounded-pill ms-1"><%= userCartCount %></span>
                            <% } %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/logout.php"><i class="fas fa-sign-out-alt me-1"></i> خروج</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 mb-5">
        <!-- مسار التنقل Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/products.php" class="text-decoration-none text-muted">الرئيسية</a></li>
                <li class="breadcrumb-item"><a href="/products.php?category_id=<%= product.category_id %>" class="text-decoration-none text-muted"><%= product.category_name %></a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= product.title %></li>
            </ol>
        </nav>

        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i> <%= successMsg %>
                <a href="/view_cart.php" class="btn btn-sm btn-success ms-3">الذهاب إلى سلة التسوق</a>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="product-main-card">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <img src="<%= resolveImage(product.image) %>" class="product-image" alt="<%= product.title %>">
                </div>
                <div class="col-lg-6">
                    <div class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill mb-3">
                        <i class="fas fa-tag me-1"></i> <%= product.category_name %>
                    </div>
                    <h2 class="fw-bold text-dark mb-3"><%= product.title %></h2>
                    
                    <p class="text-muted leading-relaxed mb-4" style="line-height: 1.8; font-size: 1.05rem;">
                        <%= product.description %>
                    </p>

                    <div class="price-box">
                        <div class="d-flex align-items-baseline gap-3 mb-2">
                            <span class="fs-1 fw-bold text-success"><%= product.offer %> ر.س</span>
                            <% if (product.price > product.offer) { %>
                                <span class="fs-4 text-decoration-line-through text-muted"><%= product.price %> ر.س</span>
                                <span class="badge bg-danger">خصم <%= Math.round(((product.price - product.offer) / product.price) * 100) %>%</span>
                            <% } %>
                        </div>
                        <small class="text-muted"><i class="fas fa-shield-alt text-success me-1"></i> شامل الضريبة والشحن السريع لجميع المدن</small>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="/cart.php?action=add&product_id=<%= product.id %>&redirect=details" class="btn btn-success flex-grow-1">
                            <i class="fas fa-cart-plus me-2"></i> إضافة إلى سلة المشتريات
                        </a>
                        <a href="/products.php" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-store me-1"></i> متابعة التسوق
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- منتجات ذات صلة -->
        <% if (related_products && related_products.length > 0) { %>
            <div class="mt-5 pt-3">
                <h3 class="fw-bold text-dark mb-4">
                    <i class="fas fa-thumbs-up text-primary me-2"></i> منتجات قد تعجبك من نفس القسم
                </h3>
                <div class="row g-4">
                    <% related_products.forEach(function(related) { %>
                        <div class="col-md-4">
                            <div class="card related-card h-100">
                                <img src="<%= resolveImage(related.image) %>" class="related-image" alt="<%= related.title %>">
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <h6 class="card-title fw-bold text-dark mb-2"><%= related.title %></h6>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold text-primary"><%= related.offer %> ر.س</span>
                                        <a href="/product_details.php?id=<%= related.id %>" class="btn btn-outline-primary btn-sm">
                                            عرض المنتج
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>
    </div>

    <footer class="text-center">
        <div class="container">
            <h5 class="fw-bold text-white mb-2">متجر ميرا الإلكتروني - Mera-Shop</h5>
            <p class="mb-0">جميع الحقوق محفوظة &copy; 2026</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
