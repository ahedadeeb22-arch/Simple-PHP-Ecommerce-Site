<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المنتجات - متجر ميرا الإلكتروني</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }
        .navbar {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%) !important;
            padding: 14px 0;
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: #fff !important;
        }
        .nav-link {
            color: #e2e8f0 !important;
            font-weight: 600;
            transition: color 0.2s ease;
            padding: 8px 14px !important;
            border-radius: 8px;
        }
        .nav-link:hover {
            color: #38bdf8 !important;
            background: rgba(255, 255, 255, 0.05);
        }
        .product-card {
            border: none;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
        }
        .product-image {
            height: 220px;
            width: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .product-card:hover .product-image {
            transform: scale(1.04);
        }
        .image-container {
            overflow: hidden;
            position: relative;
        }
        .discount-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #ef4444;
            color: #fff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
        }
        .btn-primary {
            background-color: #2563eb;
            border: none;
            border-radius: 10px;
            padding: 9px 16px;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
        }
        .btn-success {
            background-color: #10b981;
            border: none;
            border-radius: 10px;
            padding: 9px 16px;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-success:hover {
            background-color: #059669;
        }
        .form-select {
            border-radius: 12px;
            border: 1px solid #cbd5e1;
            padding: 10px 16px;
            font-weight: 600;
            background-color: #fff;
        }
        .admin-quick-bar {
            background: #eff6ff;
            border-bottom: 1px solid #bfdbfe;
            padding: 8px 0;
            font-size: 0.9rem;
        }
        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 30px 0;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <!-- شريط المدير السريع للمعاينة والتحكم -->
    <% if (currentUser && currentUser.role === 'admin') { %>
    <div class="admin-quick-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary ms-2"><i class="fas fa-shield-alt"></i> وضع المدير</span>
                <span class="text-primary fw-bold">أنت تتصفح كـ "المدير العام"</span>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin/index.php" class="btn btn-sm btn-primary">
                    <i class="fas fa-tachometer-alt me-1"></i> فتح لوحة الإدارة
                </a>
                <a href="/admin/add_product.php" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-plus me-1"></i> إضافة منتج
                </a>
            </div>
        </div>
    </div>
    <% } %>

    <!-- شريط التنقل الرئيسي -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/products.php">
                <i class="fas fa-bag-shopping text-primary me-2 ms-2 fs-3"></i> متجر ميرا
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/products.php"><i class="fas fa-home me-1"></i> الرئيسية والمنتجات</a>
                    </li>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" href="/admin/index.php"><i class="fas fa-cogs me-1"></i> لوحة التحكم</a>
                    </li>
                    <% } %>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-2">
                        <a class="nav-link position-relative btn btn-outline-light border-0 px-3" href="/view_cart.php">
                            <i class="fas fa-shopping-cart me-1"></i> سلة المشتريات
                            <% if (typeof userCartCount !== 'undefined' && userCartCount > 0) { %>
                                <span class="badge bg-danger rounded-pill ms-1"><%= userCartCount %></span>
                            <% } %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/logout.php">
                            <i class="fas fa-sign-out-alt me-1"></i> خروج (<%= currentUser ? currentUser.username : 'الزائر' %>)
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- المحتوى الرئيسي -->
    <div class="container mt-4 mb-5">
        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> <%= successMsg %>
                <a href="/view_cart.php" class="btn btn-sm btn-success ms-3">عرض السلة وإتمام الشراء</a>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-4 rounded-4 shadow-sm border">
            <div>
                <h2 class="fw-bold mb-1 text-dark">منتجاتنا المميزة 🛍️</h2>
                <p class="text-muted mb-0">تسوق أفضل المنتجات بأعلى جودة وأفضل الأسعار المخفضة</p>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <label for="category" class="form-label mb-0 fw-bold text-nowrap">
                    <i class="fas fa-filter text-primary me-1"></i> التصفية حسب القسم:
                </label>
                <select onchange="location = this.value;" class="form-select" id="category" style="min-width: 220px;">
                    <option value="/products.php">كافة الأقسام والتصنيفات</option>
                    <% categories.forEach(function(category) { %>
                        <option value="/products.php?category_id=<%= category.id %>" <%= selected_category == category.id ? 'selected' : '' %>>
                            <%= category.name %>
                        </option>
                    <% }); %>
                </select>
            </div>
        </div>

        <!-- شبكة المنتجات -->
        <div class="row g-4">
            <% if (products.length === 0) { %>
                <div class="col-12 text-center py-5">
                    <i class="fas fa-box-open text-muted fs-1 mb-3"></i>
                    <h4 class="text-muted">لا توجد منتجات متوفرة في هذا القسم حالياً</h4>
                    <a href="/products.php" class="btn btn-primary mt-2">عرض كافة المنتجات</a>
                </div>
            <% } %>

            <% products.forEach(function(product) { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card product-card">
                        <div class="image-container">
                            <img src="<%= resolveImage(product.image) %>" class="product-image" alt="<%= product.title %>">
                            <% if (product.price > product.offer) { %>
                                <span class="discount-badge">
                                    وفر <%= Math.round((product.price - product.offer)) %> ر.س
                                </span>
                            <% } %>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-2"><%= product.title %></h5>
                                <p class="card-text text-muted small mb-3" style="min-height: 40px;">
                                    <%= product.description.length > 90 ? product.description.substring(0, 90) + '...' : product.description %>
                                </p>
                            </div>
                            <div>
                                <div class="d-flex align-items-baseline gap-2 mb-3">
                                    <span class="fs-4 fw-bold text-primary"><%= product.offer %> ر.س</span>
                                    <% if (product.price > product.offer) { %>
                                        <span class="text-decoration-line-through text-muted small"><%= product.price %> ر.س</span>
                                    <% } %>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="/product_details.php?id=<%= product.id %>" class="btn btn-outline-primary w-50">
                                        <i class="fas fa-eye me-1"></i> التفاصيل
                                    </a>
                                    <a href="/cart.php?action=add&product_id=<%= product.id %>" class="btn btn-success w-50">
                                        <i class="fas fa-cart-plus me-1"></i> أضف للسلة
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- تذييل الصفحة -->
    <footer class="text-center">
        <div class="container">
            <h5 class="fw-bold text-white mb-2">متجر ميرا الإلكتروني - Mera-Shop</h5>
            <p class="mb-0">تجربة تسوق فريدة وموثوقة &copy; 2026. جميع الحقوق محفوظة.</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
